    },
    "2": {
      "$value": "inset 0 1px 0 rgba(255, 255, 255, .06), 0 8px 24px rgba(0, 0, 0, .45)",
      "$type": "shadow",
      "$extensions": {
        "com.metatoy.sorb": {
          "id": "ns-lift-2",
          "cssVar": "--ns-lift-2",
          "definedIn": "tokens/spacing.css",
