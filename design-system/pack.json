  "rules": [
    "One primary dominates a surface. Never let blue, yellow and red shout at once.",
    "Red only ever flags. It is not a decorative accent and never a normal action color.",
    "Grounds stay warm neutral. Never #000 or #fff; the gate is charcoal, not black.",
    "Ink is for type. Do not use it as a fill.",
    "Fidelity is stepped, not smooth. No gradients as structure.",
    "The hand and bitmap faces live only inside the mark. They never set running text.",
    "Every actionable control has a 44px effective hit target and a visible focus state.",
    "Honor prefers-reduced-motion: re-set statically, no bloom.",
    "Anything conveyed by color also carries a text label."
  ],
  "voice": {
    "tone": "Instrument, not marketing. Plain, exact, a little schoolroom.",
    "labels": "Uppercase mono for labels and counts; sentence case for titles and body.",
    "numbers": "Monospace with tabular alignment wherever digits line up."
  }
